function reproduce(a,b,area)
    father=area.Inds[a]
    mother=area.Inds[b]
    newGenes =[rand([father.Genes[i], mother.Genes[i]]) for i in length(father.Genes)]
    place = father.Place
    child = Ind(Genes=newGenes, Place=place)
    push!(area.Inds, child)
    n=length(area.Inds)
    push!(area.IndPos[place], n)
end

function stepBoardReproduce!(area::livingField)
    for place in eachindex(area.Board)
        people = filter(P -> area.Inds[P].Hunger<10 && (area.Inds[P].Endurance - area.Inds[P].Health)>10 , area.IndPos[place])
        while length(people)>1
            a=rand(people)
            delete!(people,a)
            b=rand(people)
            delete!(people, b)
            reproduce(a,b, area)
            area.Inds[a].Hunger+=10
            area.Inds[b].Hunger+=10
        end
    end
end

function stepBoardGenerateFood!(area::livingField, new::Int64=0)
    n=length(area.Board)
    for i in 1:n
        if area.Board[i]!=0
            area.Board[i]+=1
        end
    end
    if new!=0
        for i in 1:new
            place=rand(1:n)
            area.Board[place]+=1
        end
    end
end

function simulateLife(sizeRow, sizeColoumn, startingfood, startingPeople, newFoodRate, iterations)
    board = genBoard(sizeRow, sizeColoumn, startingfood)
    size=sizeRow*sizeColoumn
    people=[Ind(Place=rand(1:size)) for _ in 1:startingPeople]
    positions= fill(Int64[], sizeRow, sizeColoumn)
    for i in 1:startingPeople
        push!(positions[people[i].Place], i)
    end
    area=livingField(board, people, positions)
    count=0
    while count<iterations
        count+=1
        stepBoardEat!(area)
        stepBoardReproduce!(area)
        stepBoardGenerateFood!(area, newFoodRate)
    end
    return area
end
